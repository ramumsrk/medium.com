{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile C++ source using /usr/bin/g++",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-v",
                "-std=c++26",
                "-Wall",
                "-pedantic-errors",
                "-ggdb3",
                "-I",
                "${fileDirname}/../include/",
                "-o",
                "${fileDirname}/../bin/${fileBasename}.o",
                "${file}",
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}